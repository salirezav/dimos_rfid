# Copy to a private .env (gitignored) and fill in locally:
#   cp .env.example .env
#   nano .env
#
# Never put real keys / lab IPs in this file — it may be committed.
# Values here are loaded automatically by:
#   uv run python -m dimos_rfid …
#   uv run python run_semantic_rfid.py
# Shell exports always win over .env (override=False).

# --- Robot / RFID HTTP ---
ROBOT_IP=
RFID_API_BASE=http://YOUR_GO2_IP:8765/api/v1
# RFID HTTP poll rate (Hz). Default 1 = one tag snapshot per second, moving or still.
# RFID_POLL_HZ=1

# --- Dataset collection (go2-dataset / go2-dataset-rounds) ---
RFID_POWER_LADDER=30,25,20,15
# Leave unset to use dimos_rfid/paths/example_loop.json
# RFID_COLLECTION_PATH=/absolute/path/to/your_loop.json
RFID_DATASET_DIR=~/Downloads/dimos_rfid_datasets
# Optional fixed session name (otherwise UTC timestamp):
# RFID_DATASET_SESSION=warehouse_ladder1
# RFID_COLLECTION_AUTO_START=1
# RFID_DATASET_AUTO_START=1
# Skip JPEGs while nearly stationary (meters of XY travel between images):
RFID_DATASET_MIN_IMAGE_MOVE_M=0.25
RFID_DATASET_STATIONARY_SPEED_MPS=0.05
# Path JSON written by waypoint_cli mark / record-start
RFID_WAYPOINT_CAPTURE_PATH=dimos_rfid/paths/captured_path.json
RFID_PATH_RECORD_MIN_DISTANCE_M=0.35
RFID_PATH_RECORD_MAX_INTERVAL_S=2.0

# --- Gemini (Google AI Studio) — used by: run_semantic_rfid.py --agentic ---
GOOGLE_API_KEY=
RFID_AGENT_MODEL=google_genai:gemini-2.0-flash

# Optional OpenAI instead of Gemini
# OPENAI_API_KEY=
# RFID_AGENT_MODEL=gpt-4o
